# Feetech 공식 SDK(ftservo-python-sdk 2.0.1, 패키지 scservo_sdk)는 형식 정보를 주지 않는다.
# motor 패키지는 pyright strict로 보므로, 우리가 쓰는 이름만 SDK 소스를 보고 적는다.
# SDK를 올리면 이 파일도 소스와 맞는지 다시 본다.
from typing import Any

BROADCAST_ID: int
MAX_ID: int

COMM_SUCCESS: int
COMM_PORT_BUSY: int
COMM_TX_FAIL: int
COMM_RX_FAIL: int
COMM_TX_ERROR: int
COMM_RX_WAITING: int
COMM_RX_TIMEOUT: int
COMM_RX_CORRUPT: int
COMM_NOT_AVAILABLE: int

class PortHandler:
    is_open: bool
    baudrate: int
    packet_start_time: float
    packet_timeout: float
    tx_time_per_byte: float
    is_using: bool
    port_name: str
    ser: Any
    def __init__(self, port_name: str) -> None: ...
    def openPort(self) -> bool: ...
    def closePort(self) -> None: ...
    def clearPort(self) -> None: ...
    def setBaudRate(self, baudrate: int) -> bool: ...
    def getBaudRate(self) -> int: ...
    def getBytesAvailable(self) -> int: ...
    def readPort(self, length: int) -> bytes: ...
    def writePort(self, packet: list[int]) -> int: ...
    def setPacketTimeout(self, packet_length: int) -> None: ...
    def setPacketTimeoutMillis(self, msec: float) -> None: ...
    def isPacketTimeout(self) -> bool: ...
    def getCurrentTime(self) -> float: ...
    def getTimeSinceStart(self) -> float: ...
    def setupPort(self, cflag_baud: int) -> bool: ...
    def getCFlagBaud(self, baudrate: int) -> int: ...

class protocol_packet_handler:
    portHandler: PortHandler
    def __init__(self, portHandler: PortHandler, protocol_end: int) -> None: ...
    def getTxRxResult(self, result: int) -> str: ...
    def getRxPacketError(self, error: int) -> str: ...
    def ping(self, scs_id: int) -> tuple[int, int, int]: ...
    def readTxRx(self, scs_id: int, address: int, length: int) -> tuple[list[int], int, int]: ...
    def writeTxRx(
        self, scs_id: int, address: int, length: int, data: list[int]
    ) -> tuple[int, int]: ...
    def writeTxOnly(self, scs_id: int, address: int, length: int, data: list[int]) -> int: ...
    def syncReadTx(
        self, start_address: int, data_length: int, param: list[int], param_length: int
    ) -> int: ...
    def syncReadRx(self, data_length: int, param_length: int) -> tuple[int, list[int]]: ...
    def syncWriteTxOnly(
        self, start_address: int, data_length: int, param: list[int], param_length: int
    ) -> int: ...
